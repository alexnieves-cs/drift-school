{
  "name": "drift-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "In-browser self-driving RC cars. Draw a track, watch a policy learn to race and drift it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "bench": "vitest run --config vitest.bench.config.ts",
    "eval": "vite-node scripts/eval.ts --"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "@tensorflow/tfjs": "4.22.0",
    "comlink": "4.4.2",
    "fflate": "0.8.2",
    "three": "0.170.0",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@types/three": "0.170.0",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
